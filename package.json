{
  "name": "@local-hosting/vocab",
  "packageManager": "yarn@4.18.1",
  "version": "0.1.0",
  "private": true,
  "description": "Community vocabulary packs (places, resources, actors) in YAML.",
  "type": "module",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema/vocabulary.schema.json": "./schema/vocabulary.schema.json",
    "./packs/*": "./packs/*"
  },
  "files": [
    "dist",
    "packs",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build:packs": "tsx scripts/build-packs.ts",
    "build": "yarn build:packs && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "validate": "yarn build:packs && tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pretest": "yarn build",
    "ci": "yarn build && yarn validate && yarn typecheck && yarn test"
  },
  "dependencies": {
    "@local-hosting/compose": "0.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
