{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local-hosting.dev/schema/vocabulary.json",
  "title": "CommunityVocabulary",
  "type": "object",
  "required": [
    "vocab_version",
    "languages",
    "events",
    "actions",
    "places",
    "resources",
    "actors",
    "defaults"
  ],
  "additionalProperties": false,
  "properties": {
    "vocab_version": { "type": "string", "minLength": 1 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "ar",
          "en",
          "es",
          "fr",
          "he",
          "hi",
          "it",
          "nl",
          "pt",
          "ta",
          "zh-Hans",
          "zh-Hant"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/labeledId" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "places": {
      "type": "array",
      "items": { "$ref": "#/$defs/place" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "actors": {
      "type": "array",
      "items": { "$ref": "#/$defs/labeledId" }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "labeledId": {
      "type": "object",
      "required": ["id", "labels"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "labels", "events"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "place": {
      "type": "object",
      "required": ["id", "labels", "type", "h3"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Geotypes slug"
        },
        "h3": { "type": "string", "minLength": 1 },
        "wire_code": { "type": "string", "minLength": 1, "maxLength": 8 }
      }
    },
    "resource": {
      "type": "object",
      "required": ["id", "labels"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "place_id": { "type": "string", "minLength": 1 },
        "wire_code": { "type": "string", "minLength": 1, "maxLength": 8 },
        "category": { "type": "string" },
        "subcategory": { "type": "string" }
      }
    }
  }
}